{
  "name": "Credential Dumping Detection",
  "description": "Detects potential credential dumping activities including LSASS access, SAM file access, and credential dumping tools",
  "mitre_attack": {
    "tactic": "Credential Access",
    "technique": "T1003",
    "sub_techniques": ["T1003.001", "T1003.002", "T1003.003"]
  },
  "severity": "critical",
  "queries": [
    {
      "rule_name": "LSASS Process Access",
      "description": "Detects process accessing LSASS memory which is commonly used for credential dumping",
      "query": {
        "bool": {
          "must": [
            {
              "term": {
                "winlog.event_id": 10
              }
            },
            {
              "regexp": {
                "winlog.event_data.TargetImage": ".*lsass\\.exe"
              }
            }
          ],
          "must_not": [
            {
              "terms": {
                "winlog.event_data.SourceImage": [
                  "C:\\\\Windows\\\\System32\\\\taskmgr.exe",
                  "C:\\\\Windows\\\\System32\\\\wbem\\\\wmiprvse.exe"
                ]
              }
            }
          ]
        }
      },
      "index": "apt-detection-*",
      "elasticsearch_dsl": "GET /apt-detection-*/_search\n{\n  \"query\": {\n    \"bool\": {\n      \"must\": [\n        { \"term\": { \"winlog.event_id\": 10 } },\n        { \"regexp\": { \"winlog.event_data.TargetImage\": \".*lsass\\\\.exe\" } }\n      ],\n      \"must_not\": [\n        { \"terms\": { \"winlog.event_data.SourceImage\": [\n          \"C:\\\\\\\\Windows\\\\\\\\System32\\\\\\\\taskmgr.exe\",\n          \"C:\\\\\\\\Windows\\\\\\\\System32\\\\\\\\wbem\\\\\\\\wmiprvse.exe\"\n        ]}}\n      ]\n    }\n  }\n}"
    },
    {
      "rule_name": "Mimikatz Execution",
      "description": "Detects execution of Mimikatz or similar credential dumping tools",
      "query": {
        "bool": {
          "should": [
            {
              "regexp": {
                "message": ".*mimikatz.*"
              }
            },
            {
              "regexp": {
                "winlog.event_data.Image": ".*mimikatz.*"
              }
            },
            {
              "regexp": {
                "winlog.event_data.CommandLine": ".*(sekurlsa|logonpasswords|lsadump).*"
              }
            },
            {
              "regexp": {
                "message": ".*(procdump|gsecdump|wce\\.exe|pwdump).*"
              }
            }
          ],
          "minimum_should_match": 1
        }
      },
      "elasticsearch_dsl": "GET /apt-detection-*/_search\n{\n  \"query\": {\n    \"bool\": {\n      \"should\": [\n        { \"regexp\": { \"message\": \".*mimikatz.*\" } },\n        { \"regexp\": { \"winlog.event_data.Image\": \".*mimikatz.*\" } },\n        { \"regexp\": { \"winlog.event_data.CommandLine\": \".*(sekurlsa|logonpasswords|lsadump).*\" } },\n        { \"regexp\": { \"message\": \".*(procdump|gsecdump|wce\\\\.exe|pwdump).*\" } }\n      ],\n      \"minimum_should_match\": 1\n    }\n  }\n}"
    },
    {
      "rule_name": "SAM Registry Access",
      "description": "Detects access to SAM registry hive which contains password hashes",
      "query": {
        "bool": {
          "must": [
            {
              "terms": {
                "winlog.event_id": [12, 13]
              }
            },
            {
              "regexp": {
                "winlog.event_data.TargetObject": ".*\\\\SAM\\\\SAM\\\\Domains\\\\Account.*"
              }
            }
          ]
        }
      },
      "elasticsearch_dsl": "GET /apt-detection-*/_search\n{\n  \"query\": {\n    \"bool\": {\n      \"must\": [\n        { \"terms\": { \"winlog.event_id\": [12, 13] } },\n        { \"regexp\": { \"winlog.event_data.TargetObject\": \".*\\\\\\\\SAM\\\\\\\\SAM\\\\\\\\Domains\\\\\\\\Account.*\" } }\n      ]\n    }\n  }\n}"
    },
    {
      "rule_name": "NTDS.dit Access",
      "description": "Detects access to NTDS.dit file which contains Active Directory credentials",
      "query": {
        "bool": {
          "must": [
            {
              "regexp": {
                "winlog.event_data.TargetFilename": ".*ntds\\.dit"
              }
            }
          ]
        }
      },
      "elasticsearch_dsl": "GET /apt-detection-*/_search\n{\n  \"query\": {\n    \"bool\": {\n      \"must\": [\n        { \"regexp\": { \"winlog.event_data.TargetFilename\": \".*ntds\\\\.dit\" } }\n      ]\n    }\n  }\n}"
    }
  ],
  "aggregation_query": {
    "description": "Count credential dumping attempts by source process",
    "query": {
      "size": 0,
      "query": {
        "bool": {
          "must": [
            {
              "range": {
                "@timestamp": {
                  "gte": "now-1h"
                }
              }
            },
            {
              "term": {
                "threat_detected": "credential_dumping"
              }
            }
          ]
        }
      },
      "aggs": {
        "by_source_image": {
          "terms": {
            "field": "winlog.event_data.SourceImage.keyword",
            "size": 10
          }
        },
        "by_host": {
          "terms": {
            "field": "host.name.keyword",
            "size": 10
          }
        }
      }
    }
  }
}
